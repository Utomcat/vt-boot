<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.ranyk</groupId>
		<artifactId>vt-boot-starter</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>vt-boot-base-starter</artifactId>

	<name>vt-boot-base-starter</name>
	<description>基础模块</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<!-- 自动配置编程模型(@AutoConfiguration / @ConditionalOnXxx), 本模块提供 VtBootBaseAutoConfiguration -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
		</dependency>

		<!-- 仅引入 MyBatis-Plus 注解, 用于 BaseEntity 声明表映射, 不引入持久层运行时 -->
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-annotation</artifactId>
		</dependency>

		<!-- MapStruct 核心库 -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
		</dependency>

		<!-- Lombok 和 MapStruct 的绑定依赖，确保两者可以协同工作 (编译期使用, 不进入产物) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok-mapstruct-binding</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>cn.hutool</groupId>
			<artifactId>hutool-all</artifactId>
		</dependency>

		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
		</dependency>

		<!-- 国际化内核模块: 仅提供 MessageUtils 与消息资源, 不引入 Web -->
		<dependency>
			<groupId>com.ranyk</groupId>
			<artifactId>vt-boot-i18n-core</artifactId>
		</dependency>
	</dependencies>

</project>
